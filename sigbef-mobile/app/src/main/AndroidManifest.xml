<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        A câmera serve para uma coisa só: ler o QR de pareamento que a
        biblioteca mostra na tela do computador. Nada é gravado nem
        enviado; a imagem só é analisada em memória. Por isso a permissão
        é pedida na hora de escanear, e não na abertura do app.

        required="false" porque o aparelho sem câmera continua servindo:
        o endereço pode ser digitado à mão.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!--
        Aviso de devolução. O app já guarda os prazos no cache, então a
        verificação é local: não precisa de rede, nem do servidor da
        escola ligado, e funciona em casa e no fim de semana.

        A permissão é pedida quando o aluno liga o aviso nas
        configurações, não na abertura do app. E o aviso nasce
        desligado, como toda função opcional do SIGBEF.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        allowBackup desligado: o aparelho guarda o acesso do aluno e os
        dados da carteirinha. Não faz sentido esse conteúdo sair do
        celular numa cópia de segurança da nuvem.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
